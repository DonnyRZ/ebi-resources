# Large binary assets - not tracked in git
Assets/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# Testing
/coverage

# Next.js
/.next/
/out/

# Production build
/build

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Prisma generated client (regenerated via `npm run db:generate`)
/prisma/generated

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editor / OS
/.idea
/.vscode/*
!/.vscode/extensions.json

# Audit / temporary artifacts
/.audit-tmp/
/_hadith_files.txt
