.vscode
.idea
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Docker / infra files (not needed inside the build context)
Dockerfile
.dockerignore
docker-compose*.yml
nginx

# Project reference material & docs (not needed for the app build)
Design-Reference
Other-reference
Assets
*.md
structure.txt
techstack.txt

# Tests & coverage
coverage
.nyc_output
