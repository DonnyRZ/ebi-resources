# Dependencies (reinstalled inside the image via npm ci)
node_modules
**/node_modules

# Build output / caches
.next
out
dist
build
.turbo
.cache

# Version control
.git
.gitignore
.gitattributes

# Environment files (never bake secrets into the image)
.env
.env.*
!.env.example

