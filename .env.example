# =============================================================================
# EBI Resources - Environment variables
# Copy this file to ".env" and fill in real values:  cp .env.example .env
# .env is git-ignored and consumed by docker-compose.yml (env_file).
# =============================================================================

# --- Database ----------------------------------------------------------------
# In the production compose stack the host is the "db" service.
DATABASE_URL=postgresql://ebi:ebi@db:5432/ebi?schema=public
# For local `npm run dev` against docker-compose.dev.yml use:
# DATABASE_URL=postgresql://ebi:ebi@localhost:5432/ebi?schema=public

# --- Cloudflare R2 (server-side, keep secret) --------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Public (exposed to the browser) -----------------------------------------
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_SITE_URL=https://ebiresources.co.id
